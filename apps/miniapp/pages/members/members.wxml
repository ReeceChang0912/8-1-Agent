<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="eyebrow">Family Members</view>
      <view class="title">家庭成员</view>
      <view class="subtitle">家庭号、邀请、角色和分工都放在这里，任务、家务、购物才真正能联动起来。</view>
      <view class="hero-actions">
        <button class="hero-button primary" bindtap="openChatFamily">问 Chat</button>
        <button class="hero-button ghost" bindtap="openAdd">添加成员</button>
      </view>
    </view>
    <view class="hero-panel">
      <view class="panel-label">家庭号</view>
      <view class="panel-value small">{{familyId}}</view>
      <view class="panel-note">{{familyName || '家庭协作空间'}}</view>
    </view>
  </view>

  <view class="summary">
    <view class="summary-item">
      <view class="summary-num">{{summary.member_count}}</view>
      <view class="summary-label">成员总数</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{summary.active_member_count}}</view>
      <view class="summary-label">活跃成员</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{summary.chore_items}}</view>
      <view class="summary-label">家务联动</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{summary.shopping_items}}</view>
      <view class="summary-label">购物联动</view>
    </view>
  </view>

  <view class="band">
    <view class="band-head">
      <view>
        <view class="band-title">家庭操作</view>
        <view class="band-subtitle">复制家庭号、生成邀请、快速进入 Chat</view>
      </view>
      <view class="band-note" bindtap="copyFamilyId">复制家庭号</view>
    </view>
    <view class="action-row">
      <button class="action-button" loading="{{inviteLoading}}" bindtap="createInvite">生成邀请</button>
    </view>
    <view wx:if="{{inviteCode}}" class="invite-box">
      <view class="invite-title">邀请链接已生成</view>
      <view class="invite-text">{{inviteUrl}}</view>
    </view>
  </view>

  <view class="band">
    <view class="band-head">
      <view>
        <view class="band-title">家庭画像</view>
        <view class="band-subtitle">谁在贡献购物、家务、出行和任务</view>
      </view>
    </view>
    <view wx:if="{{loading}}" class="hint">正在加载成员信息...</view>
    <view wx:elif="{{topMembers.length === 0}}" class="empty">
      <view class="empty-title">暂无成员数据</view>
      <view class="empty-desc">先添加家庭成员，系统才会开始联动统计。</view>
    </view>
    <view wx:else class="top-grid">
      <block wx:for="{{topMembers}}" wx:key="name">
        <view class="top-card">
          <view class="top-name">{{item.name}}</view>
          <view class="top-meta">{{item.role}} · {{item.side}}</view>
          <view class="top-row"><text>购物</text><text>{{item.shopping.added || 0}}</text></view>
          <view class="top-row"><text>家务</text><text>{{item.chores.assigned || 0}}</text></view>
          <view class="top-row"><text>出行</text><text>{{item.travel.participations || 0}}</text></view>
          <view class="top-row"><text>任务</text><text>{{item.tasks.received || 0}}</text></view>
        </view>
      </block>
    </view>
  </view>

  <view class="band">
    <view class="band-head">
      <view>
        <view class="band-title">成员列表</view>
        <view class="band-subtitle">添加、编辑、删除都在这里</view>
      </view>
    </view>
    <view wx:if="{{members.length === 0}}" class="empty">
      <view class="empty-title">还没有成员</view>
      <view class="empty-desc">先添加第一个家庭成员。</view>
    </view>
    <view wx:else class="member-list">
      <block wx:for="{{members}}" wx:key="name">
        <view class="member-card">
          <view class="member-top">
            <view class="member-name">{{item.name}}</view>
            <view class="member-badge">{{item.permission}}</view>
          </view>
          <view class="member-sub">{{item.role}} · {{item.age}} 岁 · {{item.side}}</view>
          <view class="member-actions">
            <button class="action-btn primary" data-name="{{item.name}}" bindtap="openEdit">编辑</button>
            <button class="action-btn danger" data-name="{{item.name}}" bindtap="deleteMember">删除</button>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{addVisible}}" class="modal-mask">
    <view class="modal-card">
      <view class="modal-title">添加成员</view>
      <view class="field">
        <view class="field-label">姓名</view>
        <input class="field-input" placeholder="例如 张三" value="{{addName}}" data-field="addName" bindinput="setField" />
      </view>
      <view class="field">
        <view class="field-label">角色</view>
        <input class="field-input" placeholder="例如 父亲、母亲、孩子" value="{{addRole}}" data-field="addRole" bindinput="setField" />
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">年龄</view>
          <input class="field-input" type="number" placeholder="0" value="{{addAge}}" data-field="addAge" bindinput="setField" />
        </view>
        <view class="field-half">
          <view class="field-label">分组</view>
          <picker mode="selector" range="{{addSideOptions}}" value="{{addSideIndex}}" bindchange="changeAddSide">
            <view class="picker-value">{{addSide}}</view>
          </picker>
        </view>
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">风格</view>
          <picker mode="selector" range="{{addStyleOptions}}" value="{{addStyleIndex}}" bindchange="changeAddStyle">
            <view class="picker-value">{{addStyle}}</view>
          </picker>
        </view>
        <view class="field-half">
          <view class="field-label">权限</view>
          <picker mode="selector" range="{{addPermissionOptions}}" value="{{addPermissionIndex}}" bindchange="changeAddPermission">
            <view class="picker-value">{{addPermission}}</view>
          </picker>
        </view>
      </view>
      <view class="modal-actions">
        <button class="action-btn" bindtap="closeAdd">取消</button>
        <button class="action-btn primary" loading="{{saving}}" bindtap="saveAdd">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{editVisible}}" class="modal-mask">
    <view class="modal-card">
      <view class="modal-title">编辑成员</view>
      <view class="field">
        <view class="field-label">姓名</view>
        <view class="picker-value muted">{{editingName}}</view>
      </view>
      <view class="field">
        <view class="field-label">角色</view>
        <input class="field-input" value="{{editRole}}" data-field="editRole" bindinput="setField" />
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">年龄</view>
          <input class="field-input" type="number" value="{{editAge}}" data-field="editAge" bindinput="setField" />
        </view>
        <view class="field-half">
          <view class="field-label">分组</view>
          <picker mode="selector" range="{{editSideOptions}}" value="{{editSideIndex}}" bindchange="changeEditSide">
            <view class="picker-value">{{editSide}}</view>
          </picker>
        </view>
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">风格</view>
          <picker mode="selector" range="{{editStyleOptions}}" value="{{editStyleIndex}}" bindchange="changeEditStyle">
            <view class="picker-value">{{editStyle}}</view>
          </picker>
        </view>
        <view class="field-half">
          <view class="field-label">权限</view>
          <picker mode="selector" range="{{editPermissionOptions}}" value="{{editPermissionIndex}}" bindchange="changeEditPermission">
            <view class="picker-value">{{editPermission}}</view>
          </picker>
        </view>
      </view>
      <view class="modal-actions">
        <button class="action-btn" bindtap="closeEdit">取消</button>
        <button class="action-btn primary" loading="{{saving}}" bindtap="saveEdit">保存</button>
      </view>
    </view>
  </view>
</view>
