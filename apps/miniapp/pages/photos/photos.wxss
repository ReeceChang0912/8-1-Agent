.page {
  min-height: 100vh;
  padding: 34rpx;
  box-sizing: border-box;
  background: #f6f8f7;
  color: #17231f;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 24rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  font-size: 22rpx;
  line-height: 1.3;
  color: #7d8784;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  font-size: 52rpx;
  line-height: 1.08;
  font-weight: 800;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #66726f;
}

.hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.hero-button,
.search-clear {
  border: none;
}

.hero-button::after,
.search-clear::after {
  border: none;
}

.hero-button {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.hero-button.primary {
  background: #153f35;
  color: #fff;
}

.hero-button.ghost {
  background: #fff;
  color: #153f35;
  border: 1rpx solid #cfd9d6;
}

.hero-panel {
  flex-shrink: 0;
  width: 186rpx;
  min-height: 168rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: #153f35;
  color: #fff;
  box-sizing: border-box;
}

.panel-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.panel-value {
  margin-top: 6rpx;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 800;
}

.panel-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  padding: 22rpx 14rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
}

.summary-num {
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #0f8f62;
  word-break: break-all;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.25;
  color: #66726f;
}

.band {
  padding: 22rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
  box-shadow: 0 10rpx 28rpx rgba(26, 37, 33, 0.05);
}

.band-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.band-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.band-subtitle {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #66726f;
}

.band-note {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #edf7f3;
  color: #0f8f62;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.prompt-scroll {
  white-space: nowrap;
}

.prompt-track {
  display: flex;
  gap: 14rpx;
}

.prompt-card {
  width: 268rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f9fbfa;
  border: 1rpx solid #dfe7e4;
  flex-shrink: 0;
}

.prompt-title {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
}

.prompt-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #66726f;
}

.prompt-text {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: #0f8f62;
  word-break: break-all;
}

.search-row {
  display: flex;
  gap: 14rpx;
}

.field {
  margin-top: 16rpx;
}

.field-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  line-height: 1.25;
  color: #66726f;
}

.field-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #17231f;
}

.search-input {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #17231f;
}

.search-clear {
  flex-shrink: 0;
  width: 112rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: #153f35;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-card {
  position: relative;
  min-height: 386rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 1rpx solid #e1e7e4;
}

.photo-image {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #e2e8f0;
}

.photo-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 204rpx;
  min-height: 96rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.74) 100%);
  color: #fff;
}

.photo-title {
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.photo-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-meta,
.photo-chips {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
  padding: 12rpx 14rpx 0;
}

.photo-chips {
  padding-bottom: 14rpx;
}

.meta-chip,
.chip {
  max-width: 100%;
  padding: 7rpx 10rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #66726f;
  font-size: 21rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip {
  background: #edf7f3;
  color: #0f8f62;
}

.album-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.album-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f9fbfa;
  border: 1rpx solid #dfe7e4;
}

.album-main {
  flex: 1;
  min-width: 0;
}

.album-title {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 800;
}

.album-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #66726f;
}

.album-count {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #edf7f3;
  color: #0f8f62;
  font-size: 25rpx;
  font-weight: 800;
}

.hint,
.empty {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
}

.empty.compact {
  padding: 28rpx 20rpx;
}

.hint {
  font-size: 28rpx;
  color: #66726f;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #66726f;
}
