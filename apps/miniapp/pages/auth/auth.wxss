.page {
  min-height: 100vh;
  padding: 52rpx 34rpx 42rpx;
  box-sizing: border-box;
  background: #f6f8f7;
  color: #1e2b27;
}

.top-strip {
  width: 96rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #d95d39;
}

.hero {
  padding: 44rpx 0 36rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  flex-shrink: 0;
  text-align: center;
  border-radius: 28rpx;
  background: #153f35;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  box-shadow: 0 16rpx 28rpx rgba(21, 63, 53, 0.18);
}

.brand-text {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 52rpx;
  line-height: 1.12;
  font-weight: 800;
  color: #17231f;
  letter-spacing: 1rpx;
}

.subtitle {
  margin-top: 16rpx;
  max-width: 500rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #66726f;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #e1e7e4;
  box-shadow: 0 14rpx 34rpx rgba(26, 37, 33, 0.07);
}

.panel {
  padding: 34rpx 28rpx 28rpx;
  border-radius: 24rpx;
}

.panel-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 40rpx;
  line-height: 1.2;
  font-weight: 800;
  color: #17231f;
}

.panel-note {
  padding-bottom: 2rpx;
  font-size: 26rpx;
  color: #7d8784;
}

.field {
  margin-bottom: 22rpx;
}

.field-label {
  margin-bottom: 12rpx;
  font-size: 28rpx;
  line-height: 1.3;
  color: #5f6b67;
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 104rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
  font-size: 32rpx;
  color: #17231f;
}

.primary {
  width: 100%;
  height: 106rpx;
  line-height: 106rpx;
  border-radius: 16rpx;
  margin-top: 14rpx;
  background: #0f8f62;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 26rpx rgba(15, 143, 98, 0.2);
}

.primary::after {
  border: none;
}

.alt-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.alt-link {
  padding: 10rpx 4rpx;
  font-size: 28rpx;
  line-height: 1.35;
  color: #315f52;
}

.footnote {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #7d8784;
  text-align: center;
}
