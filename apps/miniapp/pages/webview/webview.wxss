.error-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 48rpx;
  background: #f7f8fa;
}

.error-title {
  color: #111827;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.error-desc {
  margin-top: 20rpx;
  color: #4b5563;
  font-size: 28rpx;
  line-height: 1.6;
}
