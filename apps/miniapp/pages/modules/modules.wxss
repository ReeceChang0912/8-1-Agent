.summary {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  flex: 1;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.num {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
}

.label {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.module-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.module-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
}

.status {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}

.status.ready {
  background: #e8f5e9;
  color: #2e7d32;
}

.status.planned {
  background: #fff8e1;
  color: #b26a00;
}

.desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4b5563;
}

.meta {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #9ca3af;
}
