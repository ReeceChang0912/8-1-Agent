.tone-vehicle .module-chip.active,
.tone-vehicle .type-chip.active,
.tone-vehicle .hero-button.primary {
  background: #26313a;
  border-color: #26313a;
}

.tone-vehicle .record-card {
  border-left-color: #475569;
}

.tone-fitness .hero-panel,
.tone-fitness .module-chip.active,
.tone-fitness .type-chip.active,
.tone-fitness .hero-button.primary {
  background: #7c2d12;
  border-color: #7c2d12;
}

.tone-fitness .record-card {
  border-left-color: #ea580c;
}

.tone-documents .hero-panel,
.tone-documents .module-chip.active,
.tone-documents .type-chip.active,
.tone-documents .hero-button.primary {
  background: #334155;
  border-color: #334155;
}

.tone-documents .record-card {
  border-left-color: #64748b;
}

.tone-housing .hero-panel,
.tone-housing .module-chip.active,
.tone-housing .type-chip.active,
.tone-housing .hero-button.primary {
  background: #14532d;
  border-color: #14532d;
}

.tone-housing .record-card {
  border-left-color: #16a34a;
}

.tone-health .hero-panel,
.tone-health .module-chip.active,
.tone-health .type-chip.active,
.tone-health .hero-button.primary {
  background: #9f1239;
  border-color: #9f1239;
}

.tone-health .record-card {
  border-left-color: #e11d48;
}

.tone-travel .hero-panel,
.tone-travel .module-chip.active,
.tone-travel .type-chip.active,
.tone-travel .hero-button.primary {
  background: #075985;
  border-color: #075985;
}

.tone-travel .record-card {
  border-left-color: #0284c7;
}
