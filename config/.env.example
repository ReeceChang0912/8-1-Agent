# ======================================
# 家庭智能管家 - 环境变量配置
# ======================================

# ===== 数据库配置 (必填) =====
# 阿里云RDS PostgreSQL 或 宝塔自建 PostgreSQL
# 格式: postgresql://用户名:密码@主机地址:端口/数据库名
DATABASE_URL=postgresql://admin:your_password@localhost:5432/agent

# ===== LLM API 配置 (可选，不配则使用规则模式) =====
# OpenAI 兼容 API
OPENAI_API_KEY=sk-your-key-here
# 或者通义千问 API
# QWEN_API_KEY=your-qwen-api-key

# ===== 智能家居 (可选) =====
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=your_token_here

# ===== 阿里云 OSS 照片存储 (可选) =====
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_PUBLIC_URL=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com  # 可选，CDN 加速域名

# ===== 微信机器人 (可选) =====
WECHAT_BOT_ENABLED=false

# ===== 日志配置 =====
LOG_LEVEL=INFO
