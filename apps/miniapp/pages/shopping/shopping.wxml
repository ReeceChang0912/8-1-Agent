<view class="page">
  <view class="hero">
    <view>
      <view class="eyebrow">Family Shopping</view>
      <view class="title">购物清单</view>
      <view class="subtitle">家里还缺什么、谁买好了，出门前看一眼。</view>
    </view>
    <button class="hero-button" bindtap="openChatAdd">Chat</button>
  </view>

  <view class="summary">
    <view class="summary-item">
      <view class="summary-num">{{stats.unpurchased}}</view>
      <view class="summary-label">待采购</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{stats.purchased}}</view>
      <view class="summary-label">已采购</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{stats.restock_needed}}</view>
      <view class="summary-label">需补货</view>
    </view>
  </view>

  <view class="add-card">
    <view class="input-row">
      <input class="name-input" placeholder="添加要买的东西" value="{{itemName}}" data-field="itemName" bindinput="setField" />
      <input class="qty-input" placeholder="数量" value="{{itemQuantity}}" data-field="itemQuantity" bindinput="setField" />
    </view>
    <button class="add-button" loading="{{submitting}}" bindtap="addItem">加入清单</button>
  </view>

  <view wx:if="{{restockItems.length}}" class="restock-card">
    <view class="restock-title">需要补货</view>
    <view class="restock-desc">{{restockItems.length}} 个常用品已经低于库存阈值。</view>
  </view>

  <view class="section-title">待采购</view>
  <view wx:if="{{loading}}" class="hint">正在加载清单...</view>
  <view wx:elif="{{pendingItems.length === 0}}" class="empty">
    <view class="empty-title">清单是空的</view>
    <view class="empty-desc">可以直接添加，也可以用 Chat 一句话生成采购清单。</view>
  </view>
  <view wx:else class="item-list">
    <block wx:for="{{pendingItems}}" wx:key="id">
      <view class="item-card {{item.is_restock ? 'restock' : ''}}">
        <view class="item-top">
          <view class="item-name">{{item.name}}</view>
          <view class="tag">{{item.category_text}}</view>
        </view>
        <view class="item-meta">
          <text>{{item.quantity_text}}</text>
          <text>{{item.priority_text}} · {{item.added_by_text}}</text>
        </view>
        <button class="done-btn" data-itemid="{{item.id}}" bindtap="toggleItem">标记已买</button>
      </view>
    </block>
  </view>

  <view class="section-title purchased-title" wx:if="{{purchasedItems.length}}">已采购</view>
  <view class="item-list purchased-list" wx:if="{{purchasedItems.length}}">
    <block wx:for="{{purchasedItems}}" wx:key="id">
      <view class="item-card purchased">
        <view class="item-top">
          <view class="item-name">{{item.name}}</view>
          <view class="tag done">已买</view>
        </view>
        <view class="item-meta">
          <text>{{item.quantity_text}}</text>
          <text>{{item.category_text}} · {{item.added_by_text}}</text>
        </view>
        <button class="restore-btn" data-itemid="{{item.id}}" bindtap="toggleItem">恢复待买</button>
      </view>
    </block>
  </view>
</view>
