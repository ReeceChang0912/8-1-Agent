.page {
  min-height: 100vh;
  padding: 34rpx;
  box-sizing: border-box;
  background: #f6f8f7;
  color: #17231f;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 18rpx 0 24rpx;
}

.hero-copy {
  width: 100%;
}

.eyebrow {
  font-size: 22rpx;
  line-height: 1.3;
  color: #7d8784;
}

.title {
  margin-top: 8rpx;
  font-size: 52rpx;
  line-height: 1.08;
  font-weight: 800;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #66726f;
}

.hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.hero-button,
.action-btn {
  border: none;
}

.hero-button::after,
.action-btn::after {
  border: none;
}

.hero-button {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.hero-button.primary,
.action-btn.primary {
  background: #153f35;
  color: #fff;
}

.hero-button.ghost {
  background: #fff;
  color: #153f35;
  border: 1rpx solid #cfd9d6;
}

.hero-panel {
  width: 100%;
  min-height: 132rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: #153f35;
  color: #fff;
  box-sizing: border-box;
}

.panel-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.panel-value {
  margin-top: 6rpx;
  font-size: 44rpx;
  line-height: 1.1;
  font-weight: 800;
}

.panel-note {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
}

.summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  padding: 22rpx 16rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
}

.summary-num {
  font-size: 38rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #0f8f62;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #66726f;
}

.band {
  padding: 22rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
  box-shadow: 0 10rpx 28rpx rgba(26, 37, 33, 0.05);
}

.band-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.band-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.band-subtitle {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #66726f;
}

.band-note {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #edf7f3;
  color: #0f8f62;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.trend-scroll {
  white-space: nowrap;
}

.trend-track {
  display: flex;
  gap: 14rpx;
}

.trend-card {
  width: 188rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f9fbfa;
  border: 1rpx solid #dfe7e4;
  flex-shrink: 0;
}

.trend-month {
  font-size: 30rpx;
  font-weight: 800;
}

.trend-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
}

.trend-line.income {
  color: #0f8f62;
}

.trend-line.expense {
  color: #b91c1c;
}

.picker-box,
.field-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
  font-size: 30rpx;
  color: #17231f;
}

.picker-box {
  line-height: 88rpx;
  padding: 0 22rpx;
}

.field-input {
  padding: 0 22rpx;
}

.field-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  line-height: 1.25;
  color: #66726f;
}

.form-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.form-band {
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfb 100%);
}

.tx-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tx-card {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
  box-shadow: 0 10rpx 28rpx rgba(26, 37, 33, 0.05);
}

.tx-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.tx-main {
  flex: 1;
  min-width: 0;
}

.tx-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
}

.tx-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #66726f;
}

.tx-amount {
  flex-shrink: 0;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 800;
}

.tx-amount.income {
  color: #0f8f62;
}

.tx-amount.expense {
  color: #b91c1c;
}

.tx-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.meta-chip {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
  color: #66726f;
  font-size: 22rpx;
}

.tx-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 27rpx;
  font-weight: 800;
}

.action-btn.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.hint,
.empty {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
}

.hint {
  font-size: 28rpx;
  color: #66726f;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #66726f;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 18rpx;
}

.pager-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 27rpx;
  font-weight: 800;
}

.pager-text {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #66726f;
}
