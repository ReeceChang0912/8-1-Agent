<view class="page">
  <view class="hero">
    <view class="hero-copy">
      <view class="eyebrow">Family Memory Hub</view>
      <view class="title">家庭记忆</view>
      <view class="subtitle">知识文档、AI 长期记忆和会话摘要放在同一个工作面，让 Chat 真正记住家庭上下文。</view>
      <view class="hero-actions">
        <button class="hero-button primary" bindtap="openChatPrompt" data-prompt="/memory 家庭资料" data-title="家庭记忆">问 Chat</button>
        <button class="hero-button ghost" bindtap="refresh">刷新</button>
      </view>
    </view>
    <view class="hero-panel">
      <view class="panel-label">当前视图</view>
      <view class="panel-value">{{activeTabLabel}}</view>
      <view class="panel-note">知识和记忆联动</view>
    </view>
  </view>

  <view class="summary">
    <block wx:for="{{statCards}}" wx:key="key">
      <view class="summary-item">
        <view class="summary-num">{{item.value}}</view>
        <view class="summary-label">{{item.label}}</view>
      </view>
    </block>
  </view>

  <view class="tabbar">
    <view class="tab {{activeTab === 'knowledge' ? 'active' : ''}}" bindtap="switchTab" data-tab="knowledge">知识库</view>
    <view class="tab {{activeTab === 'memory' ? 'active' : ''}}" bindtap="switchTab" data-tab="memory">AI 记忆</view>
  </view>

  <view class="band">
    <view class="band-head">
      <view>
        <view class="band-title">Chat 联动</view>
        <view class="band-subtitle">一句话查询、沉淀和修正家庭上下文</view>
      </view>
    </view>
    <scroll-view class="prompt-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="prompt-track">
        <block wx:for="{{chatPrompts}}" wx:key="prompt">
          <view class="prompt-card" bindtap="openChatPrompt" data-prompt="{{item.prompt}}" data-title="{{item.title}}">
            <view class="prompt-title">{{item.title}}</view>
            <view class="prompt-desc">{{item.desc}}</view>
            <view class="prompt-text">{{item.prompt}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <block wx:if="{{activeTab === 'knowledge'}}">
    <view class="band">
      <view class="band-head">
        <view>
          <view class="band-title">知识搜索</view>
          <view class="band-subtitle">按资料、健康、财务、旅行等分类检索</view>
        </view>
        <view class="band-note" bindtap="clearKnowledgeSearch">清空</view>
      </view>
      <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="changeCategory">
        <view class="picker-value">{{categoryLabel}}</view>
      </picker>
      <view class="search-row">
        <input class="search-input" placeholder="搜索家庭资料、证件说明、健康记录" value="{{knowledgeQuery}}" data-field="knowledgeQuery" bindinput="setField" bindconfirm="searchKnowledge" />
        <button class="search-btn" bindtap="searchKnowledge">搜索</button>
      </view>
    </view>

    <view wx:if="{{hasKnowledgeSearch}}" class="band">
      <view class="band-head">
        <view>
          <view class="band-title">搜索结果</view>
          <view class="band-subtitle">共 {{searchCountText}} 条</view>
        </view>
      </view>
      <view wx:if="{{noSearchResults}}" class="empty compact">
        <view class="empty-title">没有匹配结果</view>
        <view class="empty-desc">可以换个关键词，或者先添加一条知识。</view>
      </view>
      <view wx:else class="item-list">
        <block wx:for="{{searchResults}}" wx:key="id">
          <view class="item-card">
            <view class="item-title">{{item.title_text}}</view>
            <view class="item-sub">{{item.category_text}} · {{item.source_text}}</view>
            <view class="item-note">{{item.content_text}}</view>
            <view class="chip-row">
              <view class="meta-chip">{{item.tags_text}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="band form-band">
      <view class="band-head">
        <view>
          <view class="band-title">新增知识</view>
          <view class="band-subtitle">把家庭资料沉淀成可检索知识</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">标题</view>
        <input class="field-input" placeholder="例如 宝宝过敏史 / 车辆保险信息" value="{{formTitle}}" data-field="formTitle" bindinput="setField" />
      </view>
      <view class="field">
        <view class="field-label">内容</view>
        <textarea class="field-textarea" placeholder="输入要长期保存的资料内容" value="{{formContent}}" data-field="formContent" bindinput="setField" />
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">分类</view>
          <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{formCategoryIndex}}" bindchange="changeFormCategory">
            <view class="picker-value">{{formCategoryLabel}}</view>
          </picker>
        </view>
        <view class="field-half">
          <view class="field-label">标签</view>
          <input class="field-input" placeholder="高血压,保险" value="{{formTags}}" data-field="formTags" bindinput="setField" />
        </view>
      </view>
      <button class="save-btn" loading="{{saving}}" bindtap="addKnowledge">添加到知识库</button>
    </view>

    <view class="band">
      <view class="band-head">
        <view>
          <view class="band-title">知识文档</view>
          <view class="band-subtitle">当前共 {{documentCountText}} 条</view>
        </view>
      </view>
      <view wx:if="{{loading}}" class="hint">正在加载知识库...</view>
      <view wx:elif="{{noDocuments}}" class="empty">
        <view class="empty-title">暂无知识文档</view>
        <view class="empty-desc">先添加家庭资料，后续 Chat 就能引用。</view>
      </view>
      <view wx:else class="item-list">
        <block wx:for="{{documents}}" wx:key="id">
          <view class="item-card" bindtap="openDocumentDetail" data-id="{{item.id}}">
            <view class="item-top">
              <view class="item-main">
                <view class="item-title">{{item.title_text}}</view>
                <view class="item-sub">{{item.category_text}} · {{item.date_text}} · {{item.chunk_text}}</view>
              </view>
              <view class="status-pill">{{item.file_type_text}}</view>
            </view>
            <view class="item-note">{{item.description_text}}</view>
            <view class="chip-row">
              <view class="meta-chip">{{item.tags_text}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <block wx:if="{{activeTab === 'memory'}}">
    <view class="band">
      <view class="band-head">
        <view>
          <view class="band-title">记忆筛选</view>
          <view class="band-subtitle">查看 Chat 沉淀出的长期事实和会话摘要</view>
        </view>
        <view class="band-note" bindtap="clearMemorySearch">清空</view>
      </view>
      <picker mode="selector" range="{{memoryTypes}}" range-key="label" value="{{memoryTypeIndex}}" bindchange="changeMemoryType">
        <view class="picker-value">{{memoryTypeLabel}}</view>
      </picker>
      <view class="search-row">
        <input class="search-input" placeholder="搜索偏好、健康、车辆、证件等记忆" value="{{memoryQuery}}" data-field="memoryQuery" bindinput="setField" bindconfirm="searchMemory" />
        <button class="search-btn" bindtap="searchMemory">搜索</button>
      </view>
    </view>

    <view class="band">
      <view class="band-head">
        <view>
          <view class="band-title">AI 记忆</view>
          <view class="band-subtitle">当前共 {{memoryCountText}} 条</view>
        </view>
      </view>
      <view wx:if="{{loading}}" class="hint">正在加载 AI 记忆...</view>
      <view wx:elif="{{noMemories}}" class="empty">
        <view class="empty-title">暂无记忆</view>
        <view class="empty-desc">和 Chat 多聊几轮，系统会自动沉淀长期事实。</view>
      </view>
      <view wx:else class="item-list">
        <block wx:for="{{memories}}" wx:key="id">
          <view class="item-card">
            <view class="item-top">
              <view class="item-main">
                <view class="item-title">{{item.title_text}}</view>
                <view class="item-sub">{{item.date_text}} · 重要性 {{item.importance_text}} · {{item.source_text}}</view>
              </view>
              <view class="status-pill">{{item.memory_type}}</view>
            </view>
            <view class="item-note">{{item.content_text}}</view>
            <view class="chip-row">
              <view class="meta-chip">{{item.tags_text}}</view>
            </view>
            <view class="item-actions">
              <button class="action-btn primary" data-id="{{item.id}}" bindtap="openEditMemory">编辑</button>
              <button class="action-btn danger" data-id="{{item.id}}" bindtap="deleteMemory">删除</button>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>

  <view wx:if="{{detailVisible}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head">
        <view>
          <view class="modal-title">{{detailTitle}}</view>
          <view class="modal-sub">{{detailMeta}}</view>
        </view>
        <view class="modal-close" bindtap="closeDetail">关闭</view>
      </view>
      <view wx:if="{{detailLoading}}" class="hint">正在加载详情...</view>
      <view wx:else>
        <view class="modal-tags">{{detailTagsText}}</view>
        <scroll-view class="modal-content" scroll-y>
          <view class="detail-text">{{detailContent}}</view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view wx:if="{{editMemoryVisible}}" class="modal-mask">
    <view class="modal-panel">
      <view class="modal-head">
        <view>
          <view class="modal-title">编辑记忆</view>
          <view class="modal-sub">修正 Chat 的长期上下文</view>
        </view>
        <view class="modal-close" bindtap="closeEditMemory">关闭</view>
      </view>
      <view class="field">
        <view class="field-label">内容</view>
        <textarea class="field-textarea" value="{{editContent}}" data-field="editContent" bindinput="setField" />
      </view>
      <view class="field-row">
        <view class="field-half">
          <view class="field-label">重要性</view>
          <input class="field-input" type="digit" value="{{editImportance}}" data-field="editImportance" bindinput="setField" />
        </view>
        <view class="field-half">
          <view class="field-label">标签</view>
          <input class="field-input" value="{{editTags}}" data-field="editTags" bindinput="setField" />
        </view>
      </view>
      <button class="save-btn" loading="{{saving}}" bindtap="saveMemory">保存记忆</button>
    </view>
  </view>
</view>
