# Copy this file to ../.env or provide these variables in your deployment environment.
# Never commit real secrets.

DATABASE_URL=postgresql://user:password@host:5432/database
CHROMA_DB_DIR=data/memory/chroma_db

# LLM provider: mock, openai, qwen, deepseek, ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Optional object storage for photos.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=

# Optional weather provider.
QWEATHER_API_KEY=
