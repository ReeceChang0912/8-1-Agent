.page {
  min-height: 100vh;
  padding: 34rpx;
  box-sizing: border-box;
  background: #f6f8f7;
  color: #17231f;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0 24rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  font-size: 22rpx;
  line-height: 1.3;
  color: #7d8784;
  letter-spacing: 0;
}

.title {
  margin-top: 8rpx;
  font-size: 52rpx;
  line-height: 1.08;
  font-weight: 800;
}

.subtitle {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #66726f;
}

.hero-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.hero-button,
.search-clear,
.action-btn {
  border: none;
}

.hero-button::after,
.search-clear::after,
.action-btn::after {
  border: none;
}

.hero-button {
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.hero-button.primary,
.action-btn.primary {
  background: #153f35;
  color: #fff;
}

.hero-button.ghost {
  background: #fff;
  color: #153f35;
  border: 1rpx solid #cfd9d6;
}

.hero-panel {
  flex-shrink: 0;
  width: 192rpx;
  min-height: 172rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  background: #153f35;
  color: #fff;
  box-sizing: border-box;
}

.panel-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.panel-value {
  margin-top: 10rpx;
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 800;
}

.panel-note {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
}

.module-switch {
  margin-bottom: 20rpx;
}

.module-scroll,
.prompt-scroll,
.type-scroll {
  white-space: nowrap;
}

.module-track,
.prompt-track,
.type-track {
  display: flex;
  gap: 14rpx;
}

.module-chip {
  min-width: 112rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #dfe7e4;
  box-sizing: border-box;
  text-align: center;
  flex-shrink: 0;
}

.module-chip.active {
  background: #153f35;
  border-color: #153f35;
  color: #fff;
}

.module-chip-title {
  font-size: 27rpx;
  font-weight: 800;
}

.summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.summary-item {
  padding: 22rpx 14rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
}

.summary-num {
  font-size: 34rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #0f8f62;
  word-break: break-all;
}

.summary-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.25;
  color: #66726f;
}

.band {
  padding: 22rpx;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
  box-shadow: 0 10rpx 28rpx rgba(26, 37, 33, 0.05);
}

.band-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.band-title {
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 800;
}

.band-subtitle {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #66726f;
}

.band-note {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: #edf7f3;
  color: #0f8f62;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.prompt-card {
  width: 268rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f9fbfa;
  border: 1rpx solid #dfe7e4;
  flex-shrink: 0;
}

.prompt-title {
  font-size: 30rpx;
  line-height: 1.2;
  font-weight: 800;
}

.prompt-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.45;
  color: #66726f;
}

.prompt-text {
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: #0f8f62;
  word-break: break-all;
}

.type-chip {
  min-width: 132rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f4f7f6;
  border: 1rpx solid #dfe7e4;
  box-sizing: border-box;
  flex-shrink: 0;
}

.type-chip.active {
  background: #153f35;
  border-color: #153f35;
  color: #fff;
}

.type-label {
  font-size: 27rpx;
  line-height: 1.25;
  font-weight: 800;
}

.type-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  opacity: 0.78;
}

.search-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.search-input,
.field-input,
.field-textarea,
.picker-value {
  box-sizing: border-box;
  font-size: 30rpx;
  color: #17231f;
}

.search-input,
.field-input,
.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
}

.search-input,
.field-input,
.picker-value {
  padding: 0 22rpx;
}

.search-input {
  flex: 1;
}

.search-clear {
  flex-shrink: 0;
  width: 100rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 28rpx;
  font-weight: 700;
}

.form-band {
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfb 100%);
}

.field {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 10rpx;
  font-size: 25rpx;
  line-height: 1.25;
  color: #66726f;
}

.field-textarea {
  width: 100%;
  min-height: 164rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #d8e0dc;
  background: #f9fbfa;
}

.form-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e1e7e4;
  border-left: 8rpx solid #0f8f62;
  box-shadow: 0 10rpx 28rpx rgba(26, 37, 33, 0.05);
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 32rpx;
  line-height: 1.4;
  font-weight: 800;
}

.record-sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #66726f;
}

.status-pill {
  flex-shrink: 0;
  max-width: 180rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef8f4;
  color: #0f8f62;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-note {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #44504a;
}

.record-chips {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.meta-chip {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f4f7f6;
  color: #66726f;
  font-size: 22rpx;
  line-height: 1.2;
}

.record-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 27rpx;
  font-weight: 800;
}

.action-btn.primary {
  background: #edf7f3;
  color: #0f8f62;
}

.action-btn.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.hint,
.empty {
  padding: 36rpx 24rpx;
  border-radius: 20rpx;
  text-align: center;
}

.hint {
  font-size: 28rpx;
  color: #66726f;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.5;
  color: #66726f;
}

.tone-insurance .hero-panel,
.tone-insurance .module-chip.active,
.tone-insurance .type-chip.active,
.tone-insurance .hero-button.primary {
  background: #17406d;
  border-color: #17406d;
}

.tone-insurance .record-card {
  border-left-color: #2563eb;
}

