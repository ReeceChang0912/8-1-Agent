.hero {
  padding: 32rpx 0 24rpx;
}

.eyebrow {
  font-size: 24rpx;
  color: #6b7280;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.title {
  margin-top: 12rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #111827;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #4b5563;
}

.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
}

.primary {
  background: #1677ff;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 28rpx;
}
